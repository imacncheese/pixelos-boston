<?xml version="1.0" encoding="utf-8"?>
<!--
    Input:
        device/motorola/sm6450-common/gps/android/2.1/android.hardware.gnss@2.1-service-qti.xml

    Both fqnames must stay declared: hwservicemanager refuses to register the
    2.1 service unless its 1.1 superclass is also in the device manifest.
    (The Android 16 compatibility check only rejects the *AIDL* GNSS v1 entry,
    which is why the separate AIDL fragment is empty on this build.)
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.gnss</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IGnss/default</fqname>
        <fqname>@2.1::IGnss/default</fqname>
    </hal>
</manifest>
